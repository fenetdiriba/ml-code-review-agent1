{
  "name": "ml-code-review-buddy",
  "displayName": "ML Code Review Buddy",
  "description": "AI agent that reviews ML code in Jupyter notebooks",
  "version": "0.0.1",
  "publisher": "nvidia-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/2guud4u/Nvidia-agent.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:mlCodeReview.openChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mlCodeReview.openChat",
        "title": "Open Chat Assistant",
        "category": "ML Code Review"
      }
    ],
    "menus": {}
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
