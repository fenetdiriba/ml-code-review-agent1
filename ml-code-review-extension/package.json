{
  "name": "ml-code-review-buddy",
  "displayName": "ML Code Review Buddy",
  "description": "AI agent that reviews ML code in Jupyter notebooks",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:jupyter"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mlCodeReview.analyzeNotebook",
        "title": "Analyze Notebook",
        "category": "ML Code Review"
      },
      {
        "command": "mlCodeReview.uploadImage",
        "title": "Upload Image for Analysis",
        "category": "ML Code Review"
      },
      {
        "command": "mlCodeReview.openChat",
        "title": "Open Chat Assistant",
        "category": "ML Code Review"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mlCodeReview.analyzeNotebook",
          "when": "resourceExtname == .ipynb",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
